# Public values from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=https://studio.example.com

# Server only. Never prefix these with NEXT_PUBLIC_ or commit real values.
# @supabase/server backend configuration. Use the full secret key locally.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
RESEND_API_KEY=your-resend-api-key
INVITE_FROM_EMAIL=DARA Studio <invites@your-verified-domain.com>

# Optional AI providers. Keep all provider keys server-side.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Optional Instagram professional-account import.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
